{
  "name": "top-skeets",
  "version": "1.0.0",
  "description": "Bluesky Feed Generator \u2014 your posts ranked by likes",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "probe": "node dist/probe.js",
    "test": "tsc && node --test test/*.test.js",
    "test:browser": "tsc && node test/browser/run.js",
    "oauth:genkey": "node scripts/oauth-genkey.js"
  },
  "dependencies": {
    "@atproto-labs/fetch-node": "^0.2.0",
    "@atproto/api": "^0.13.0",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/oauth-client": "^0.6.1",
    "@atproto/oauth-client-node": "^0.3.17",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
