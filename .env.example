PORT=3000
FEEDGEN_HOSTNAME=your-app.railway.app
FEEDGEN_SERVICE_DID=did:web:your-app.railway.app
# Directory where feed JSON files are stored (mount a persistent volume here).
# Legacy DATABASE_PATH is still honored as a fallback — its directory is used.
DATA_DIR=./data
# How often the scheduler ticks, in minutes (feeds refresh only when due)
REFRESH_INTERVAL_MINUTES=5

# Public AppView used for reads. Swap in a community AppView without touching code.
APPVIEW_URL=https://public.api.bsky.app
# Cap on this server's requests per second to the AppView, shared by feed refreshes and (later)
# game crawls. 0 means no pacing. Set it after measuring with `npm run probe`.
APPVIEW_MAX_RPS=0
# How many reverse proxies sit in front of the server (Railway: 1). Used to read the visitor's
# address from X-Forwarded-For safely. The server logs one [net] line at the first request so
# you can check this is right.
TRUSTED_PROXY_HOPS=1
# Saved quote-post games are not live yet. Leave unset or "false".
GAMES_ENABLED=false
