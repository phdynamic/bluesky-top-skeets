PORT=3000
FEEDGEN_HOSTNAME=your-app.railway.app
FEEDGEN_SERVICE_DID=did:web:your-app.railway.app
# Directory where feed JSON files are stored (mount a persistent volume here).
# Legacy DATABASE_PATH is still honored as a fallback — its directory is used.
DATA_DIR=./data
# How often the scheduler ticks, in minutes (feeds refresh only when due)
REFRESH_INTERVAL_MINUTES=5

# Public AppView used for reads. Swap in a community AppView without touching code.
APPVIEW_URL=https://public.api.bsky.app
# Cap on this server's requests per second to the AppView, shared by feed refreshes and (later)
# game crawls. 0 means no pacing. Set it after measuring with `npm run probe`.
APPVIEW_MAX_RPS=0
# How many reverse proxies sit in front of the server (Railway: 1). Used to read the visitor's
# address from X-Forwarded-For safely. The server logs one [net] line at the first request so
# you can check this is right.
TRUSTED_PROXY_HOPS=1
# Saved quote-post games are not live yet. Leave unset or "false".
GAMES_ENABLED=false
# Saved games (only used when GAMES_ENABLED=true). Defaults shown.
# Most quotes one saved game may hold; a bigger game is stored as "partial" and resumes on refresh.
GAMES_SIZE_CAP=5000
# Minimum hours between refreshes of the same game.
GAMES_REFRESH_COOLDOWN_HOURS=6
# Pause between the game crawler's own requests to Bluesky (on top of the shared budget).
GAMES_CRAWL_GAP_MS=250
# Abuse limits on creating games.
GAMES_MAX_CREATES_PER_IP_PER_HOUR=3
GAMES_MAX_CREATES_PER_DAY=100
GAMES_MAX_QUEUED=20
# Re-check every saved game for deleted posts this often (days), and how long resolved reports are kept.
GAMES_SWEEP_DAYS=7
GAMES_REPORT_RETENTION_DAYS=30
# Minimum minutes between "re-check for deleted posts" requests on the same game.
GAMES_RECHECK_COOLDOWN_MINUTES=60
# A deleted post is wiped from saved games after it has been missing on two checks at least this many hours apart.
GAMES_WIPE_SPACING_HOURS=1
# Optional: the at:// address of one stable public post (for example a pinned post of yours). Used as an extra control
# to tell "Bluesky is not answering" from "these posts are really gone". Leave empty to use posts already saved.
GAMES_HEALTH_POST=
# Admin page and tools at /admin. Leave empty to switch them off; otherwise a long random secret.
ADMIN_SECRET=
# Sign in with Bluesky (lets people remove their own posts and original posters control their game).
# Off unless OAUTH_PUBLIC_URL is set: the public https address of this site, e.g. https://professorkiosk.wtf.
# For testing on your own computer use http://127.0.0.1:3000 (no key needed).
OAUTH_PUBLIC_URL=
# The signing key, one line of JSON. Make it once with:  npm run oauth:genkey   Keep it secret.
OAUTH_PRIVATE_KEY_JWK=
# Where takedown and removal requests are sent (shown on the policy page for saved games).
TAKEDOWN_CONTACT=phdynamic@icloud.com
